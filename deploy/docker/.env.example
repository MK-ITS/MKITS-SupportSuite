# Copy to .env and adjust. Never commit .env.

# Public URL under which users reach the server (scheme + host, no trailing slash).
MKITS_PUBLIC_BASE_URL=https://support.example.com

# Image to run ("edge" = latest main build; pin a release version such as :0.1.0 for production once releases exist).
MKITS_IMAGE=ghcr.io/mk-its/mkits-supportsuite-server:edge

# Local port the reverse proxy forwards to (bound to 127.0.0.1 only).
MKITS_HTTP_PORT=8080

# Time zone for log timestamps (data is always stored in UTC).
TZ=Europe/Berlin
