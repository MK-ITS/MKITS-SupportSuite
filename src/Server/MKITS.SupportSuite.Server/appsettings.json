{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Mkits": {
    "PublicBaseUrl": "http://localhost:8080",
    "DataDirectory": "data",
    "ReverseProxy": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  }
}
