<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The MKITS server: web UI (admin, supporter, customer portal), REST API, session broker and relay.
    Runs on Ubuntu 26.04+ inside Docker behind an nginx reverse proxy (see deploy/).
  -->
  <PropertyGroup>
    <RootNamespace>MKITS.SupportSuite.Server</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="QRCoder" />
    <!-- Design-time only: needed by "dotnet ef migrations add" (see .github/workflows/ef-migration.yml). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\MKITS.SupportSuite.Common\MKITS.SupportSuite.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MKITS.SupportSuite.Server.Tests" />
  </ItemGroup>
</Project>
