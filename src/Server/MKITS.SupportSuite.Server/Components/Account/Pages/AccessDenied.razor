@page "/account/access-denied"

<PageTitle>@L["AccessDenied_Title"]</PageTitle>

<section class="card narrow">
    <h1>@L["AccessDenied_Title"]</h1>
    <p>@L["AccessDenied_Text"]</p>
    <AuthorizeView Roles="@Roles.Admin">
        <p>@L["AccessDenied_TwoFactorHint"] <a href="@LoginCompletion.TwoFactorSetupPath">@L["Manage_TwoFactorLink"]</a></p>
    </AuthorizeView>
</section>
