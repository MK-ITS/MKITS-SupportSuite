<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Release tool (ADR-0023): writes <file>.manifest.json and <file>.manifest.sig for an agent build, signed with the
    release key (PKCS#8 PEM, ECDSA P-256). Used by the image build when the CI secret is present. Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MKITS.SupportSuite.UpdateSigner</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Agent\MKITS.SupportSuite.Agent.Core\MKITS.SupportSuite.Agent.Core.csproj" />
  </ItemGroup>
</Project>
