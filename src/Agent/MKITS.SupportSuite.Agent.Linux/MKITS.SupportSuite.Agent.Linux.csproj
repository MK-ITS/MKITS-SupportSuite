<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Linux agent (Debian, Ubuntu): X11 and Wayland (xdg-desktop-portal / PipeWire) capture and input,
    PTY shell, graphical ad-hoc client (Avalonia, AppImage), later systemd unit and .deb packaging.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MKITS.SupportSuite.Agent.Linux</RootNamespace>
    <AssemblyName>mkits-agent</AssemblyName>
    <!-- LibraryImport (source-generated P/Invoke) with function pointers and blittable structs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linux only: Unix file modes, /proc, libc. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MKITS.SupportSuite.Agent.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Graphical ad-hoc client (code-only UI, no XAML). -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- D-Bus client for xdg-desktop-portal (Wayland screen cast and remote desktop). -->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MKITS.SupportSuite.Agent.Core\MKITS.SupportSuite.Agent.Core.csproj" />
  </ItemGroup>
</Project>
