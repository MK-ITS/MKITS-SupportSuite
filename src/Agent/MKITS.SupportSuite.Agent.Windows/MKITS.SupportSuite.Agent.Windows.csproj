<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows agent (Windows 10 x64+ / Server 2016+). Phase 8A: portable ad-hoc client (WinForms UI, GDI capture
    with JPEG, SendInput, clipboard, chat). DXGI/H.264, the service for secure desktop / UAC and ConPTY follow.
    Builds on Linux too (EnableWindowsTargeting) so CI can compile it anywhere.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport (source-generated P/Invoke) with blittable structs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The runtime identifier (win-x64) is set at publish time: dotnet publish -r win-x64 -p:PublishSingleFile=true -->
    <RootNamespace>MKITS.SupportSuite.Agent.Windows</RootNamespace>
    <AssemblyName>MKITS-Support</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase for the temporary service of the elevated ad-hoc mode. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <InternalsVisibleTo Include="MKITS.SupportSuite.Agent.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MKITS.SupportSuite.Agent.Core\MKITS.SupportSuite.Agent.Core.csproj" />
  </ItemGroup>
</Project>
