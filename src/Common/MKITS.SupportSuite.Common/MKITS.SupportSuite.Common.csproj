<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Code shared by server, agents and native viewer: product metadata, protocol definitions, common contracts.
    Must not depend on ASP.NET Core or any platform-specific API.
  -->
  <PropertyGroup>
    <RootNamespace>MKITS.SupportSuite.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MKITS.SupportSuite.Common.Tests" />
  </ItemGroup>

  <!--
    Agent auto-update (ADR-0023):
    - BuildNumber orders builds (CI: commit timestamp, -p:BuildNumber=...). Local builds are 0 and never offered as updates.
    - The update public key (base64 SPKI, ECDSA P-256) is compiled in from deploy/keys/agent-update.pub. Without it
      agents never apply updates. The private key exists only as a CI secret.
  -->
  <PropertyGroup>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <AgentUpdateKeyFile>$(MSBuildThisFileDirectory)../../../deploy/keys/agent-update.pub</AgentUpdateKeyFile>
    <AgentUpdatePublicKey Condition="'$(AgentUpdatePublicKey)' == '' And Exists('$(AgentUpdateKeyFile)')">$([System.IO.File]::ReadAllText('$(AgentUpdateKeyFile)').Trim())</AgentUpdatePublicKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildNumber</_Parameter1>
      <_Parameter2>$(BuildNumber)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdatePublicKey</_Parameter1>
      <_Parameter2>$(AgentUpdatePublicKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- Build-time code generator only (protoc); not shipped. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema in /proto is the single source of truth (ADR-0017). Messages only, no gRPC services. -->
    <Protobuf Include="..\..\..\proto\mkits\v0\*.proto" ProtoRoot="..\..\..\proto" GrpcServices="None" Access="Public" />
  </ItemGroup>
</Project>
